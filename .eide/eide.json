{
  "name": "Power-Sampler-F411",
  "type": "ARM",
  "dependenceList": [],
  "srcDirs": [
    "Core/Src",
    "BSP/Src",
    "Driver/Src",
    "Service/Src",
    "App/Src",
    "Drivers/STM32F4xx_HAL_Driver/Src"
  ],
  "virtualFolder": {
    "name": "<virtual_root>",
    "files": [
      {
        "path": "startup_stm32f411xe.s"
      }
    ],
    "folders": []
  },
  "outDir": "build/eide",
  "deviceName": "STM32F411CEUx",
  "packDir": null,
  "miscInfo": {
    "uid": "power-sampler-f411-0001"
  },
  "targets": {
    "Release": {
      "excludeList": [],
      "toolchain": "GCC",
      "compileConfig": {
        "cpuType": "Cortex-M4",
        "floatingPointHardware": "single",
        "scatterFilePath": "STM32F411CEUx_FLASH.ld",
        "useCustomScatterFile": true,
        "storageLayout": {
          "RAM": [],
          "ROM": []
        },
        "options": "null"
      },
      "uploader": "OpenOCD",
      "uploadConfig": {
        "bin": "",
        "target": "stm32f4x",
        "interface": "stlink",
        "baseAddr": "0x08000000"
      },
      "uploadConfigMap": {},
      "custom_dep": {
        "name": "default",
        "incList": [
          "Core/Inc",
          "BSP/Inc",
          "Driver/Inc",
          "Service/Inc",
          "App/Inc",
          "Drivers/STM32F4xx_HAL_Driver/Inc",
          "Drivers/STM32F4xx_HAL_Driver/Inc/Legacy",
          "Drivers/CMSIS/Device/ST/STM32F4xx/Include",
          "Drivers/CMSIS/Include"
        ],
        "libList": [],
        "defineList": [
          "USE_HAL_DRIVER",
          "STM32F411xE"
        ]
      },
      "builderOptions": {
        "GCC": {
          "version": 5,
          "beforeBuildTasks": [],
          "afterBuildTasks": [],
          "global": {
            "$float-abi-type": "hard",
            "output-debug-info": "enable",
            "misc-control": "--specs=nano.specs -u _printf_float"
          },
          "c/cpp-compiler": {
            "language-c": "c11",
            "language-cpp": "c++11",
            "optimization": "level-2",
            "warnings": "all-warnings",
            "one-elf-section-per-function": true,
            "one-elf-section-per-data": true
          },
          "asm-compiler": {},
          "linker": {
            "output-format": "elf",
            "remove-unused-input-sections": true,
            "LD_FLAGS": "-Wl,--print-memory-usage",
            "LIB_FLAGS": "-lm"
          }
        }
      }
    }
  },
  "version": "3.5"
}
